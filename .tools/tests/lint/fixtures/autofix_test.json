{
  "test_comment_spacing_preserves_comments_and_indentation": {
    "sample": "$a = 1\n# Explain b.\n$b = 2\n# Explain c.\n$c = 3\n",
    "sample2": "$a = 1\n\n# Explain b.\n$b = 2\n\n# Explain c.\n$c = 3\n",
    "sample3": "if $active {\n  $a = 1\n  /* Explain b. */\n  $b = 2\n}\n",
    "sample4": "if $active {\n  $a = 1\n\n  /* Explain b. */\n  $b = 2\n}\n"
  },
  "test_layout_fixes_commas_blank_lines_and_nested_arrays": {
    "sample": "$values = [\n      [\n        'a','b',\n      ],\n]\nif $active { # Explain.\n\n \t\n  notice('Active')\n}\n",
    "sample2": "$values = [\n  [\n    'a', 'b',\n  ],\n]\nif $active { # Explain.\n  notice('Active')\n}\n"
  },
  "test_layout_parameter_trailing_comma_and_nested_default": {
    "sample": "class example (\n  Array[String] $items = concat(['a','b'], ['c']) # Keep this reason.\n) {}\n",
    "sample2": "class example (\n  Array[String] $items = concat(['a', 'b'], ['c']), # Keep this reason.\n) {}\n"
  },
  "test_array_resource_titles_use_the_resource_level": {
    "sample": "file { [\n'/tmp/a',\n'/tmp/b',\n]:\n  ensure => absent,\n}\n",
    "sample2": "file { [\n    '/tmp/a',\n    '/tmp/b',\n  ]:\n  ensure => absent,\n}\n"
  },
  "test_parameter_alignment_uses_the_whole_block": {
    "sample": "class example (\n  String $a,\n  Optional[String] $label=  undef,\n  String $longer = 'value',\n) {}\n",
    "sample2": "class example (\n  String           $a,\n  Optional[String] $label  = undef,\n  String           $longer = 'value',\n) {}\n"
  },
  "test_parameter_alignment_with_multiline_types_and_defaults": {
    "sample": "define example (\n  Variant[\n    String,\n    Array[String]\n  ] $a = [\n    'value',\n  ],\n  String $long = 'value',\n) {}\n",
    "sample2": "define example (\n  Variant[\n    String,\n    Array[String]\n  ]      $a    = [\n    'value',\n  ],\n  String $long = 'value',\n) {}\n"
  },
  "test_parameter_alignment_does_not_move_comments_or_inline_parameters": {
    "sample": "class example (String $a, String $long = 'value') {}\n",
    "sample2": "class example (\n  String /* Type explanation. */ $a = 'a',\n  String $long = 'b',\n) {}\n"
  },
  "test_ignored_findings_are_never_fixed": {
    "sample": "class example (\n  String $a = 'a',\n  Optional[String] $long = undef,\n) {}\n",
    "sample2": "Notify['target'] -> [File['/z'], File['/a']]\n",
    "sample3": "# @summary Example.\n# @api public\nclass example {}\n"
  },
  "test_partial_suppression_prevents_edits_across_the_ignored_region": {
    "code": "class example (\n  String $a = 'a',\n  Optional[String] $long = undef, # lint:ignore:project_parameter_alignment\n) {}\n",
    "code2": "Notify['target'] -> File[\n  '/z',\n  '/a', # lint:ignore:project_resource_references\n]\n"
  },
  "test_literal_contents_and_correct_code_remain_unchanged": {
    "code": "$text = @(TEXT)\n{\n\n'a','b'\nTEXT\n$other = 'a,b'\n$values = [\n  'a',\n]\n"
  },
  "test_all_checks_fix_the_same_region_in_one_pass": {
    "sample": "Notify['target'] -> [\n      File[\"/z\"],File[\"/a\"]\n]\n",
    "sample2": "Notify['target'] -> File['/a', '/z']\n",
    "sample3": "Notify['target'] -> [\n      Package[\"z\"],\n      Service[\"z\"],\n      Package[\"a\"],\n      Service[\"a\"]\n]\n",
    "sample4": "Notify['target'] -> [\n  Package['a', 'z'],\n  Service['a', 'z'],\n]\n",
    "sample5": "Notify['target'] -> [Package[\"z\",\"b\"],Service[\"nginx\"],Package[\"a\",\"a\"]]\n",
    "sample6": "Notify['target'] -> [Package['a', 'a', 'b', 'z'], Service['nginx']]\n"
  },
  "test_repeated_indentation_fixes_handle_empty_whitespace_tokens": {
    "sample": "$command = join([\n      'first',\n      'second',\n    ], ' ')\n",
    "sample2": "$command = join([\n  'first',\n  'second',\n], ' ')\n"
  },
  "test_documentation_and_comment_spacing_share_the_surviving_anchor": {
    "before": "$value = 'example'\n# lint:ignore:140chars\n# @summary Example.\n# @api public\n# lint:endignore\nclass example {}\n",
    "after": "$value = 'example'\n\n# @summary Example.\n#\n# @api public\nclass example {}\n"
  },
  "test_layout_does_not_move_comments_between_comma_and_value": {
    "code": "$values = [1,/* Keep this reason. */2]\n"
  },
  "test_upstream_whitespace_and_custom_alignment_share_live_tokens": {
    "sample": "class example (\n\tEnum['a','b'] $a = 'a',\n  String $long=  'b'\n) {}\n",
    "sample2": "class example (\n  Enum['a', 'b'] $a    = 'a',\n  String         $long = 'b',\n) {}\n"
  },
  "test_type_width_changes_keep_previously_correct_parameter_alignment": {
    "sample": "class example (\n  Enum['a','b'] $a = 'a',\n  String        $b = 'b',\n) {}\n",
    "sample2": "class example (\n  Enum['a', 'b'] $a = 'a',\n  String         $b = 'b',\n) {}\n",
    "sample3": "class example (\n  Enum[\"a\", \"b\"] $a = 'a',\n  String         $b = 'b',\n) {}\n",
    "sample4": "class example (\n  Enum['a', 'b'] $a = 'a',\n  String         $b = 'b',\n) {}\n"
  },
  "test_removed_upstream_quote_tokens_do_not_break_spacing_anchors": {
    "sample": "class example (\n  String $a= \"${value}\"\n) {}\n",
    "sample2": "class example (\n  String $a = $value,\n) {}\n"
  },
  "test_array_baseline_accounts_for_upstream_tab_expansion": {
    "sample": "if $active {\n\t$values = [\n   'a',\n ]\n}\n",
    "sample2": "if $active {\n  $values = [\n    'a',\n  ]\n}\n"
  },
  "test_heredoc_parameter_endings_remain_manual_without_changing_the_body": {
    "code": "class example (\n  String $label = @(TEXT)\nLiteral {\n\n'a','b'\nTEXT\n) {}\n"
  }
}
