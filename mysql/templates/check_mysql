#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'MySQL check cannot run: %s\n' "$*"
    exit 3
}

# Puppet selects whether systemd dependencies and unit inspection apply to this check.
SYSTEMD_ENABLE='<%= @systemd_enable %>'

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
MYSQLADMIN=$(command -v mysqladmin 2>/dev/null) || die "mysqladmin not available"
if [ "$SYSTEMD_ENABLE" = true ]; then
    SYSTEMDCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
fi

# Credentials are read from the local Debian-maintained defaults file unless the caller overrides it.
DEFAULTS_FILE="/etc/mysql/debian.cnf"

# Connection and cache thresholds stay local because this check manages one MySQL endpoint.
WARN_CONN_CURR_PCT=90   # WARNING when current connections >= 90%
CRIT_CONN_CURR_PCT=95   # CRITICAL at 95%
WARN_CONN_PEAK_PCT=90   # WARNING when historical peak >= 90%
CRIT_CONN_PEAK_PCT=95   # CRITICAL at 95%
WARN_HIT_PCT=95         # WARNING when buffer hit < 95%
CRIT_HIT_PCT=90         # CRITICAL when buffer hit < 90%

# Runtime state collects the worst status and human-readable causes.
LONG_OUTPUT=""
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}
LONG_OUTPUT_SEP="__CHECK_MYSQL_NL__"
STATE_CODE=0
ISSUES=""

# CLI options only select the credentials file; thresholds are intentionally fixed by the managed check.
USAGE_TEXT="Usage: $0 [-c <config_file>]"
OPTERR=0
while getopts "c:" opt; do
    case "$opt" in
        c) DEFAULTS_FILE="$OPTARG" ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "long-output detail character limit must be numeric" ;;
esac
[ "$DETAIL_LIMIT" -ge 1 ] || die "long-output detail character limit must be at least 1"

# Emit a direct CRITICAL result and stop immediately.
crit() {
    printf 'MySQL %s\n' "$*"
    exit 2
}

# Append one direct cause to the summary without exposing Nagios state labels.
add_issue() {
    if [ -n "$ISSUES" ]; then
        ISSUES="${ISSUES}; $1"
    else
        ISSUES=$1
    fi
}

# Keep MySQL status text safe before the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $AWK '{gsub(/[|]/, "[or]"); print}'
}

# Append one diagnostic line to the long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Bound diagnostic details before adding Interpretation so final operator guidance stays visible in monitoring UIs.
limit_long_output_details() {
    [ -n "$LONG_OUTPUT" ] || return

    LONG_OUTPUT=$(
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" -v max="$DETAIL_LIMIT" '
            function emit(line) {
                printf "%s%s", (printed ? sep : ""), line
                printed = 1
            }
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    line = lines[i]
                    line_len = length(line)
                    separator_len = printed ? 1 : 0
                    if (used + separator_len + line_len <= max) {
                        emit(line)
                        used += separator_len + line_len
                        continue
                    }
                    remaining = max - used - separator_len
                    if (remaining > 0) {
                        emit(substr(line, 1, remaining) "... [detail truncated]")
                    }
                    emit("Long output details truncated after " max " characters to keep Interpretation visible.")
                    exit
                }
            }
        '
    )
}

# Emit one monitoring line followed by the fixed MySQL diagnostic context.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    print lines[i]
                }
            }
        '
    fi
}

# Convert empty or non-numeric input to zero.
parse_to_int() {
    case "$1" in
        ''|*[!0-9]*) printf '%s\n' 0 ;;
        *)           printf '%s\n' "$1" ;;
    esac
}

# Extract one mysqladmin field by name from a pipe table.
get_field() {
    NEEDLE="$1"
    INPUT="$2"
    printf '%s\n' "$INPUT" | $AWK -F'|' -v n="$NEEDLE" '
    {
        gsub(/^ +| +$/, "", $2)  # trim column
        gsub(/^ +| +$/, "", $3)  # trim value
        if (toupper($2)==toupper(n)) { print $3; exit }
    }'
}

# Read one extended-status field from the cached output.
sf()  { get_field "$1" "$STATUS_OUT"; }

# Read one variables field from the cached output.
var() { get_field "$1" "$VAR_OUT"; }

# The defaults file carries local credentials; unreadable credentials make the check unusable.
[ -r "$DEFAULTS_FILE" ] || crit "defaults-file $DEFAULTS_FILE not readable"

if [ "$SYSTEMD_ENABLE" = true ]; then
# systemd gives the direct service state before mysqladmin performs protocol checks.
$SYSTEMDCTL is-active --quiet "mysql.service" || crit "service is not active"

fi
# mysqladmin ping confirms the daemon is accepting local administrative connections.
$MYSQLADMIN --defaults-file="$DEFAULTS_FILE" ping >/dev/null 2>/dev/null || crit "service running but not responding"

# Cache status and variables from one point in time so derived metrics are internally consistent.
STATUS_OUT=$($MYSQLADMIN --defaults-file="$DEFAULTS_FILE" extended-status 2>/dev/null) || die "Cannot read extended-status"
VAR_OUT=$($MYSQLADMIN --defaults-file="$DEFAULTS_FILE" variables 2>/dev/null) || die "Cannot read variables"

# Pull only the counters used for status and perfdata; absent fields become zero below.
THREADS_CONNECTED=$(parse_to_int "$(sf Threads_connected)")
THREADS_RUNNING=$(parse_to_int "$(sf Threads_running)")
SLOW_QUERIES=$(parse_to_int "$(sf Slow_queries)")
MAX_USED_CONN=$(parse_to_int "$(sf Max_used_connections)")
MAX_CONNECTIONS=$(parse_to_int "$(var max_connections)")
UPTIME=$(parse_to_int "$(sf Uptime)")
BUF_READ_REQ=$(parse_to_int "$(sf Innodb_buffer_pool_read_requests)")
BUF_READS=$(parse_to_int "$(sf Innodb_buffer_pool_reads)")
BUF_WAIT_FREE=$(parse_to_int "$(sf Innodb_buffer_pool_wait_free)")
BUF_PAGES_FREE=$(parse_to_int "$(sf Innodb_buffer_pool_pages_free)")
BUF_PAGES_TOTAL=$(parse_to_int "$(sf Innodb_buffer_pool_pages_total)")

# Buffer-pool hit rate is computed only when read requests exist.
if [ "$BUF_READ_REQ" -gt 0 ]; then
    HIT_RATE_PCT=$($AWK -v reads="$BUF_READS" -v requests="$BUF_READ_REQ" 'BEGIN { printf "%.1f", (1 - (reads / requests)) * 100 }')
else
    HIT_RATE_PCT="N/A"
fi

# Connection thresholds are percentages, but perfdata needs the equivalent absolute limits.
if [ "$MAX_CONNECTIONS" -gt 0 ]; then
    CONN_PCT=$((THREADS_CONNECTED * 100 / MAX_CONNECTIONS))
    if [ "$CONN_PCT" -ge "$CRIT_CONN_CURR_PCT" ]; then
        STATE_CODE=2
        add_issue "connection usage ${CONN_PCT}% (${THREADS_CONNECTED}/${MAX_CONNECTIONS})"
    elif [ "$CONN_PCT" -ge "$WARN_CONN_CURR_PCT" ]; then
        STATE_CODE=1
        add_issue "connection usage ${CONN_PCT}% (${THREADS_CONNECTED}/${MAX_CONNECTIONS})"
    fi

    PEAK_PCT=$((MAX_USED_CONN * 100 / MAX_CONNECTIONS))
    if [ "$PEAK_PCT" -ge "$CRIT_CONN_PEAK_PCT" ]; then
        STATE_CODE=2
        add_issue "historical connection peak ${PEAK_PCT}% (${MAX_USED_CONN}/${MAX_CONNECTIONS})"
    elif [ "$PEAK_PCT" -ge "$WARN_CONN_PEAK_PCT" ]; then
        [ $STATE_CODE -lt 2 ] && STATE_CODE=1
        add_issue "historical connection peak ${PEAK_PCT}% (${MAX_USED_CONN}/${MAX_CONNECTIONS})"
    fi

    WARN_CURR_ABS=$((MAX_CONNECTIONS * WARN_CONN_CURR_PCT / 100))
    CRIT_CURR_ABS=$((MAX_CONNECTIONS * CRIT_CONN_CURR_PCT / 100))
    WARN_PEAK_ABS=$((MAX_CONNECTIONS * WARN_CONN_PEAK_PCT / 100))
    CRIT_PEAK_ABS=$((MAX_CONNECTIONS * CRIT_CONN_PEAK_PCT / 100))
else
    STATE_CODE=3
    add_issue "max_connections is zero"
    WARN_CURR_ABS=""
    CRIT_CURR_ABS=""
    WARN_PEAK_ABS=""
    CRIT_PEAK_ABS=""
fi

# Low buffer hit rate is a cache-efficiency signal; missing data is kept out of status.
if [ "$HIT_RATE_PCT" != "N/A" ]; then
    HIT_RATE_TEXT="${HIT_RATE_PCT}%"
    INT_HIT=${HIT_RATE_PCT%.*}
    if [ "$INT_HIT" -lt "$CRIT_HIT_PCT" ]; then
        STATE_CODE=2
        add_issue "buffer hit rate ${HIT_RATE_PCT}%"
    elif [ "$INT_HIT" -lt "$WARN_HIT_PCT" ]; then
        [ $STATE_CODE -lt 2 ] && STATE_CODE=1
        add_issue "buffer hit rate ${HIT_RATE_PCT}%"
    fi
    WARN_HIT_RANGE="${WARN_HIT_PCT}:"
    CRIT_HIT_RANGE="${CRIT_HIT_PCT}:"
    HIT_RATE_METRIC="${HIT_RATE_PCT}%"
else
    WARN_HIT_RANGE=""
    CRIT_HIT_RANGE=""
    HIT_RATE_METRIC=U
    HIT_RATE_TEXT="unavailable"
fi

# Buffer wait events indicate pressure even when the hit-rate threshold has not fired.
if [ "$BUF_WAIT_FREE" -gt 0 ]; then
    [ $STATE_CODE -lt 2 ] && STATE_CODE=1
    add_issue "InnoDB wait events ${BUF_WAIT_FREE}"
fi

# Slow-query count is cumulative and therefore only raises WARNING.
if [ "$SLOW_QUERIES" -gt 0 ]; then
    [ $STATE_CODE -lt 2 ] && STATE_CODE=1
    add_issue "slow queries ${SLOW_QUERIES}"
fi

# Keep the summary cause-oriented; counters are emitted as perfdata.
OUTPUT_MSG="MySQL is responding"
[ -n "$ISSUES" ] && OUTPUT_MSG="${OUTPUT_MSG}; ${ISSUES}"

# Long output explains the summary with the observed MySQL state and separates status inputs from supporting counters.
append_long "Connection usage: ${THREADS_CONNECTED}/${MAX_CONNECTIONS} current, ${MAX_USED_CONN}/${MAX_CONNECTIONS} historical peak, ${THREADS_RUNNING} running thread(s)"
append_long "InnoDB buffer pool: hit rate ${HIT_RATE_TEXT}, ${BUF_PAGES_FREE}/${BUF_PAGES_TOTAL} pages free, ${BUF_WAIT_FREE} wait event(s)"
append_long "Workload counters: uptime ${UPTIME}s, slow queries ${SLOW_QUERIES}"
limit_long_output_details
append_long ""
append_long "Interpretation:"
append_long "mysqladmin ping, current connection usage, historical connection peak, buffer hit rate, InnoDB wait events, and slow-query count decide the exit code."
append_long "Inspect connection pressure, the processlist, buffer-pool sizing, and the slow query log first when the summary reports MySQL issues."

# Perfdata labels are unit-free; low-water hit-rate thresholds use Nagios range syntax.
PERF="curr_connections=${THREADS_CONNECTED};${WARN_CURR_ABS};${CRIT_CURR_ABS};0;${MAX_CONNECTIONS}"
PERF="${PERF} max_used_connections=${MAX_USED_CONN};${WARN_PEAK_ABS};${CRIT_PEAK_ABS};0;${MAX_CONNECTIONS}"
PERF="${PERF} threads_running=${THREADS_RUNNING};;;0"
PERF="${PERF} slow_queries=${SLOW_QUERIES}c"
PERF="${PERF} hit_rate=${HIT_RATE_METRIC};${WARN_HIT_RANGE};${CRIT_HIT_RANGE};0;100"
PERF="${PERF} innodb_pages_free=${BUF_PAGES_FREE};;;0;${BUF_PAGES_TOTAL}"

# Emit one monitoring line; the summary and long output are sanitized so dynamic MySQL text cannot add perfdata separators.
emit_check "$OUTPUT_MSG" "$PERF"
exit $STATE_CODE
