#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'Network check cannot run: %s\n' "$*"
    exit 3
}

# Puppet selects whether systemd dependencies and unit inspection apply to this check.
SYSTEMD_ENABLE='<%= @systemd_enable %>'

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
CAT=$(command -v cat 2>/dev/null) || die "cat not available"
DIG=$(command -v dig 2>/dev/null) || die "dig not available"
GREP=$(command -v grep 2>/dev/null) || die "grep not available"
IP=$(command -v ip 2>/dev/null) || die "ip not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
if [ "$SYSTEMD_ENABLE" = true ]; then
    SYSTEMDCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
    NETWORKCTL=$(command -v networkctl 2>/dev/null)  || die "networkctl not available"
else
    PS=$(command -v ps 2>/dev/null) || die "ps not available"
fi
TR=$(command -v tr 2>/dev/null) || die "tr not available"

# Summary state and DNS options are shared by interface and service checks.
CRIT_MSG=""
DIG_OPTS="+short +time=1 +tries=1"
DOWN_COUNT=0
DOWN_LIST=""
FAILOVER_NOTE=""

# Address-family flags decide whether public-IP lookups are meaningful.
HAS_V4=0
HAS_V6=0

# Interface filter input and bounded long-output state.
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}
IF_FILTERS=${IF_FILTERS:-""}
IF_LIST=<%= @interfaces_str_shell %>

# IPv4 address class counters are emitted as global perfdata.
IPV4_CGNAT=0
IPV4_LINK=0
IPV4_LOOP=0
IPV4_PRIVATE=0
IPV4_PUBLIC=0
IPV4_TOTAL=0

# IPv6 address class counters are emitted as global perfdata.
IPV6_GUA=0
IPV6_HOST=0
IPV6_LINK=0
IPV6_SCOPE_GLOBAL=0
IPV6_TOTAL=0
IPV6_ULA=0

# Long output and optional service checks share the same final network status.
LONG_OUTPUT=""
LONG_OUTPUT_SEP="__CHECK_NETWORK_NL__"
SERVICES_IDS=""
SERVICES_LIST=<%= @service_str_shell %>
SERVICES=${SERVICES:-""}
STATE_CODE=0
SVC_ACTIVE=0
SVC_DOWN_LIST=""
SVC_INACTIVE=0
SVC_TOTAL=0

# Link-state counters support wired/Wi-Fi failover handling.
UP_COUNT=0
WIFI_UP_COUNT=0
WIFI_UP_LIST=""
WIRED_DOWN_COUNT=0
WIRED_DOWN_LIST=""
WIRED_UP_COUNT=0
WIRED_UP_LIST=""

# CLI options can narrow service/interface scope and bound interface detail output for one check invocation.
USAGE_TEXT="Usage: $0 [-s <services>] [-i <iface globs>] [-l <chars>]
Environment: SERVICES (-s); IF_FILTERS (-i); DETAIL_LIMIT (-l).
Command-line options override non-empty environment values; unset or empty environment values use defaults."
OPTERR=0
while getopts ':s:i:l:h' opt; do
    case "$opt" in
        s) SERVICES="$OPTARG" ;;
        i) IF_FILTERS="$OPTARG" ;;
        l) DETAIL_LIMIT="$OPTARG" ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "detail limit must be numeric" ;;
esac
[ "$DETAIL_LIMIT" -ge 1 ] || die "detail limit must be at least 1"

# Append one critical reason to the summary.
add_crit() {
    CRIT_MSG="${CRIT_MSG:+$CRIT_MSG; }$1";
}

# Sanitize an interface name into a safe perfdata label.
sanitize_label() {
    # Replace unsafe characters and normalize case so the dynamic suffix remains valid inside `if_<name>_*` perfdata labels.
    printf '%s' "$1" | $TR '[:upper:]' '[:lower:]' | $SED 's/[^a-z0-9_]/_/g'
}

# Keep interface, SSID, and service names safe before the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Append one diagnostic line to the bounded long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Store one interface detail line; final long output is capped once before Interpretation.
append_interface_detail() {
    append_long "$1"
}

# Bound diagnostic details before adding Interpretation so final operator guidance stays visible in monitoring UIs.
limit_long_output_details() {
    [ -n "$LONG_OUTPUT" ] || return

    LONG_OUTPUT=$(
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" -v max="$DETAIL_LIMIT" '
            function emit(line) {
                printf "%s%s", (printed ? sep : ""), line
                printed = 1
            }
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    line = lines[i]
                    line_len = length(line)
                    separator_len = printed ? 1 : 0
                    if (used + separator_len + line_len <= max) {
                        emit(line)
                        used += separator_len + line_len
                        continue
                    }
                    remaining = max - used - separator_len
                    if (remaining > 0) {
                        emit(substr(line, 1, remaining) "... [detail truncated]")
                    }
                    emit("Long output details truncated after " max " characters to keep Interpretation visible.")
                    exit
                }
            }
        '
    )
}

# Emit one monitoring line followed by sanitized interface details.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    print lines[i]
                }
            }
        '
    fi
}

# Return success when the interface matches one configured filter.
iface_matches() {
    # Empty IF_LIST means every non-loopback interface is in scope.
    [ -z "$IF_LIST" ] && return 0

    _NAME=$1
    _OLDIFS=$IFS
    IFS=' ' # split IF_LIST on spaces (normalized to single spaces)
    for _pat in $IF_LIST; do
        case "$_NAME" in
            $_pat)
                IFS=$_OLDIFS
                return 0
                ;;
        esac
    done
    IFS=$_OLDIFS
    return 1
}

# Select the configured service backend and preserve its success or failure status for each service.
service_active() {
    if [ "$SYSTEMD_ENABLE" = true ]; then
        $SYSTEMDCTL is-active --quiet "$1"
    else
        $PS -C "$1" >/dev/null 2>&1
    fi
}

# Extract Wi-Fi SSID/BSSID from networkctl output when systemd-networkd is available.
wifi_info() {
    _IF="$1"
    _SSID=""
    _BSSID=""

if [ "$SYSTEMD_ENABLE" = true ]; then
    # Pull the AP line from networkctl
    _OUT=$(SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 $NETWORKCTL status "$_IF" --no-pager 2>/dev/null)
    _LINE=$(printf '%s\n' "$_OUT" | $AWK '
        /^[[:space:]]*(WiFi|Wi-?Fi)[[:space:]]+access[[:space:]]+point:/ {
            sub(/^[[:space:]]*(WiFi|Wi-?Fi)[[:space:]]+access[[:space:]]+point:[[:space:]]*/, "", $0)
            print; exit
        }')

    if [ -n "$_LINE" ]; then
        # Extract a trailing BSSID only when the final parenthesized value is a MAC address.
        _BSSID=$(printf '%s' "$_LINE" | $SED -n 's/.*(\([0-9A-Fa-f]\{2\}\(:[0-9A-Fa-f]\{2\}\)\{5\}\))[[:space:]]*$/\1/p')

        # SSID is the remainder after stripping trailing " (MAC)" and trimming trailing spaces.
        _SSID=$(printf '%s' "$_LINE" | $SED -e 's/(\([0-9A-Fa-f]\{2\}\(:[0-9A-Fa-f]\{2\}\)\{5\}\))[[:space:]]*$//' -e 's/[[:space:]]*$//')

        # Normalize placeholders sometimes seen in older outputs.
        [ "$_SSID"  = "(null)" ] && _SSID=""
        [ "$_BSSID" = "00:00:00:00:00:00" ] && _BSSID=""
    fi
fi

    # Escape any quotes in SSID to keep long output readable.
    [ -n "$_SSID" ] && _SSID=$(printf '%s' "$_SSID" | $SED 's/"/\\"/g')

    # Use an explicit sentinel so SSIDs with pipes do not corrupt the shell parser.
    if [ -n "$_SSID" ] || [ -n "$_BSSID" ]; then
        printf '%s__CHECK_NETWORK_AP_SEP__%s' "$_SSID" "$_BSSID"
    fi
    return 0
}

# Normalize services; CLI values override the Puppet-rendered list.
[ -n "$SERVICES" ] && SERVICES_LIST="$SERVICES"
if [ -n "$SERVICES_IDS" ]; then
    SERVICES_LIST=$(printf '%s' "$SERVICES_IDS" | $TR ',' ' ')
fi

# Normalize interface filters so case patterns can use simple whitespace splitting.
if [ -n "$IF_FILTERS" ]; then
    IF_LIST=$(printf '%s' "$IF_FILTERS" | $TR ',' ' ' | $SED 's/[[:space:]]\+/ /g; s/^ //; s/ $//')
fi

# Optional service checks are folded into the same network summary.
if [ -n "$SERVICES_LIST" ]; then
    for SVC in $SERVICES_LIST; do
        SVC_TOTAL=$((SVC_TOTAL + 1))
        if service_active "$SVC"; then
            SVC_ACTIVE=$((SVC_ACTIVE + 1))
        else
            SVC_INACTIVE=$((SVC_INACTIVE + 1))
            SVC_DOWN_LIST="${SVC_DOWN_LIST:+$SVC_DOWN_LIST,}$SVC"
        fi
    done
    [ -n "$SVC_DOWN_LIST" ] && add_crit "services down: $SVC_DOWN_LIST"
fi

# Enumerate interfaces from the kernel and exclude loopback from operational checks.
MATCHED_IF_COUNT=0
for IFACE_RAW in $($IP -o link show | $AWK -F': ' '{print $2}'); do
    IFACE=${IFACE_RAW%%@*}
    [ "$IFACE" = "lo" ] && continue

    # Apply filters; if none supplied, accept all
    if ! iface_matches "$IFACE"; then
        continue
    fi
    MATCHED_IF_COUNT=$((MATCHED_IF_COUNT + 1))

    # Detect Wi-Fi by sysfs presence
    IS_WIFI=0
    [ -d "/sys/class/net/$IFACE/wireless" ] && IS_WIFI=1

    # Determine UP/DOWN
    if $IP link show dev "$IFACE" 2>/dev/null | $GREP -q "state UP"; then
        IS_UP=1
        UP_COUNT=$((UP_COUNT + 1))
        if [ $IS_WIFI -eq 1 ]; then
            WIFI_UP_COUNT=$((WIFI_UP_COUNT + 1))
            WIFI_UP_LIST="${WIFI_UP_LIST:+$WIFI_UP_LIST,}$IFACE"
        else
            WIRED_UP_COUNT=$((WIRED_UP_COUNT + 1))
            WIRED_UP_LIST="${WIRED_UP_LIST:+$WIRED_UP_LIST,}$IFACE"
        fi
    else
        IS_UP=0
        DOWN_COUNT=$((DOWN_COUNT + 1))
        [ -z "$DOWN_LIST" ] && DOWN_LIST="$IFACE" || DOWN_LIST="$DOWN_LIST,$IFACE"

        # Track wired down for failover policy
        if [ $IS_WIFI -eq 0 ]; then
            WIRED_DOWN_COUNT=$((WIRED_DOWN_COUNT + 1))
            WIRED_DOWN_LIST="${WIRED_DOWN_LIST:+$WIRED_DOWN_LIST,}$IFACE"
        fi
    fi

    # Address lists are rendered in long output; perfdata carries the aggregate counters.
    V4_LIST=$($IP -o -4 addr show dev "$IFACE" 2>/dev/null | $AWK '{print $4}')
    V6_LIST=$($IP -o -6 addr show dev "$IFACE" 2>/dev/null | $AWK '{print $4}')

    # Compose one bounded interface detail line for long output.
    STATE_STR=$([ "$IS_UP" -eq 1 ] && printf UP || printf DOWN)
    DETAIL_SUFFIX=""
    [ -n "$V4_LIST" ] && DETAIL_SUFFIX="$DETAIL_SUFFIX; IPv4 $(printf '%s' "$V4_LIST" | $TR '\n' ',' | $SED 's/,$//')"
    [ -n "$V6_LIST" ] && DETAIL_SUFFIX="$DETAIL_SUFFIX; IPv6 $(printf '%s' "$V6_LIST" | $TR '\n' ',' | $SED 's/,$//')"

    # If Wi-Fi is up, include AP identity in long output without putting it in the short status line.
    if [ $IS_WIFI -eq 1 ] && [ "$IS_UP" -eq 1 ]; then
        APINFO=$(wifi_info "$IFACE")
        if [ -n "$APINFO" ]; then
            SSID_VAL=${APINFO%%__CHECK_NETWORK_AP_SEP__*}
            BSSID_VAL=${APINFO#*__CHECK_NETWORK_AP_SEP__}
            [ -n "$SSID_VAL" ]  && DETAIL_SUFFIX="$DETAIL_SUFFIX; AP \"$SSID_VAL\""
            [ -n "$BSSID_VAL" ] && DETAIL_SUFFIX="$DETAIL_SUFFIX; BSSID $BSSID_VAL"
        fi
    fi

    append_interface_detail "Interface ${IFACE}: ${STATE_STR}${DETAIL_SUFFIX}"

    # Per-interface stats from sysfs (if available)
    RX_BYTES="" TX_BYTES="" RX_ERRS="" TX_ERRS="" MTU="" SPEED=""
    BASE="/sys/class/net/$IFACE"
    [ -r "$BASE/statistics/rx_bytes" ] && RX_BYTES=$($CAT "$BASE/statistics/rx_bytes" 2>/dev/null)
    [ -r "$BASE/statistics/tx_bytes" ] && TX_BYTES=$($CAT "$BASE/statistics/tx_bytes" 2>/dev/null)
    [ -r "$BASE/statistics/rx_errors" ] && RX_ERRS=$($CAT "$BASE/statistics/rx_errors" 2>/dev/null)
    [ -r "$BASE/statistics/tx_errors" ] && TX_ERRS=$($CAT "$BASE/statistics/tx_errors" 2>/dev/null)
    [ -r "$BASE/mtu" ] && MTU=$($CAT "$BASE/mtu" 2>/dev/null)
    [ -r "$BASE/speed" ] && SPEED=$($CAT "$BASE/speed" 2>/dev/null)

    IF_LBL=$(sanitize_label "$IFACE")

    # IPv4 classification distinguishes public, private, CGNAT, and link-local addresses.
    V4_T=0 V4_PUB=0 V4_PRIV=0 V4_CGNAT=0 V4_LINK=0
    V4_KV=$($IP -o -4 addr show dev "$IFACE" 2>/dev/null | $AWK '
        BEGIN{t=0;pub=0;priv=0;cgn=0;ll=0}
        {
            split($4,a,"/"); ip=a[1]
            if (ip ~ /^169\.254\./) ll++
            else if (ip ~ /^10\./ || ip ~ /^192\.168\./ || ip ~ /^172\.(1[6-9]|2[0-9]|3[0-1])\./) priv++
            else if (ip ~ /^100\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\./) cgn++
            else pub++
            t++
        }
        END{printf "total=%d\npublic=%d\nprivate=%d\ncgnat=%d\nlink=%d\n", t,pub,priv,cgn,ll}
    ')
    while IFS='=' read -r K V; do
        case "$K" in
            total) V4_T=$V ;;
            public) V4_PUB=$V ;;
            private) V4_PRIV=$V ;;
            cgnat) V4_CGNAT=$V ;;
            link) V4_LINK=$V ;;
        esac
    done <<EOF
$V4_KV
EOF

    IPV4_TOTAL=$((IPV4_TOTAL + V4_T))
    IPV4_PUBLIC=$((IPV4_PUBLIC + V4_PUB))
    IPV4_PRIVATE=$((IPV4_PRIVATE + V4_PRIV))
    IPV4_CGNAT=$((IPV4_CGNAT + V4_CGNAT))
    IPV4_LINK=$((IPV4_LINK + V4_LINK))

    if [ "$HAS_V4" -eq 0 ]; then
        V4_HAS=$((V4_PUB + V4_PRIV + V4_CGNAT))
        [ "$V4_HAS" -gt 0 ] && HAS_V4=1
    fi

    # IPv6 classification distinguishes global scope, GUA, ULA, link-local, and host addresses.
    V6_GLOB=0 V6_GUA_I=0 V6_HST=0 V6_LNK=0 V6_T=0 V6_ULA_I=0
    V6_KV=$($IP -o -6 addr show dev "$IFACE" 2>/dev/null | $AWK '
        BEGIN{IGNORECASE=1; t=0; glob=0; lnk=0; hst=0; gua=0; ula=0}
        {
            split($4,a,"/"); ip=a[1]; sc=""
            for (i=1;i<=NF;i++) if ($i=="scope" && i<NF) { sc=$(i+1); break }
            if (sc=="link") lnk++
            else if (sc=="host") hst++
            else if (sc=="global") {
                glob++
                if (ip ~ /^(fc|fd)/) ula++
                else if (ip ~ /^[23]/) gua++   # 2000::/3
            }
            t++
        }
        END{printf "total=%d\nscope_global=%d\nlink=%d\nhost=%d\ngua=%d\nula=%d\n", t,glob,lnk,hst,gua,ula}
    ')
    while IFS='=' read -r K V; do
        case "$K" in
            total) V6_T=$V ;;
            scope_global) V6_GLOB=$V ;;
            link) V6_LNK=$V ;;
            host) V6_HST=$V ;;
            gua) V6_GUA_I=$V ;;
            ula) V6_ULA_I=$V ;;
        esac
    done <<EOF
$V6_KV
EOF

    IPV6_TOTAL=$((IPV6_TOTAL + V6_T))
    IPV6_SCOPE_GLOBAL=$((IPV6_SCOPE_GLOBAL + V6_GLOB))
    IPV6_LINK=$((IPV6_LINK + V6_LNK))
    IPV6_HOST=$((IPV6_HOST + V6_HST))
    IPV6_GUA=$((IPV6_GUA + V6_GUA_I))
    IPV6_ULA=$((IPV6_ULA + V6_ULA_I))

    [ "$HAS_V6" -eq 0 ] && [ "$V6_GLOB" -gt 0 ] && HAS_V6=1

    # Per-interface perfdata. Kernel byte and error statistics are monotonic counters, so they use the Nagios `c` UOM.
    PERF="${PERF:+$PERF }if_${IF_LBL}_up=${IS_UP};;;0;1"
    [ -n "$RX_BYTES" ] && PERF="$PERF if_${IF_LBL}_rx=${RX_BYTES}c"
    [ -n "$TX_BYTES" ] && PERF="$PERF if_${IF_LBL}_tx=${TX_BYTES}c"
    [ -n "$RX_ERRS" ] && PERF="$PERF if_${IF_LBL}_rx_errors=${RX_ERRS}c"
    [ -n "$TX_ERRS" ] && PERF="$PERF if_${IF_LBL}_tx_errors=${TX_ERRS}c"
    [ -n "$MTU" ] && PERF="$PERF if_${IF_LBL}_mtu=${MTU};;;0"

    # /sys speed is Mb/s; keep the label unit-free and put Mbps in the UOM.
    if [ -n "$SPEED" ] && printf '%s' "$SPEED" | $GREP -Eq '^[0-9]+$' && [ "$SPEED" -gt 0 ]; then
        PERF="$PERF if_${IF_LBL}_speed=${SPEED}Mbps;;;0"
    fi

    # Per-interface IPv4/IPv6 address class counts
    PERF="$PERF if_${IF_LBL}_v4_total=${V4_T};;;0"
    PERF="$PERF if_${IF_LBL}_v4_public=${V4_PUB};;;0"
    PERF="$PERF if_${IF_LBL}_v4_private=${V4_PRIV};;;0"
    PERF="$PERF if_${IF_LBL}_v4_cgnat=${V4_CGNAT};;;0"
    PERF="$PERF if_${IF_LBL}_v4_link_local=${V4_LINK};;;0"
    PERF="$PERF if_${IF_LBL}_v6_total=${V6_T};;;0"
    PERF="$PERF if_${IF_LBL}_v6_scope_global=${V6_GLOB};;;0"
    PERF="$PERF if_${IF_LBL}_v6_link_local=${V6_LNK};;;0"
    PERF="$PERF if_${IF_LBL}_v6_host=${V6_HST};;;0"
    PERF="$PERF if_${IF_LBL}_v6_gua=${V6_GUA_I};;;0"
    PERF="$PERF if_${IF_LBL}_v6_ula=${V6_ULA_I};;;0"
done

# Interface filters that match nothing are treated as a configuration/runtime fault.
if [ -n "$IF_LIST" ] && [ "$MATCHED_IF_COUNT" -eq 0 ]; then
    add_crit "no interfaces matched filters: $IF_LIST"
fi

# Count IPv4 loopback addresses explicitly
IPV4_LOOP=$($IP -o -4 addr show dev lo 2>/dev/null | $AWK '
    BEGIN{c=0}
    { split($4,a,"/"); ip=a[1]; if (ip ~ /^127\./) c++ }
    END{print c}
')

# Public IPv4 lookup runs only when local IPv4 addressing exists.
if [ "$HAS_V4" -eq 1 ]; then
    PUBIP_V4=$($DIG -4 @ns1.google.com TXT o-o.myaddr.l.google.com $DIG_OPTS 2>/dev/null | $SED -n 's/^"\(.*\)"$/\1/p' | $AWK '/^([0-9]{1,3}\.){3}[0-9]{1,3}$/{print; exit}')
    if [ -z "$PUBIP_V4" ] || [ "$PUBIP_V4" = "0.0.0.0" ]; then
        PUBIP_V4=$($DIG -4 TXT ch whoami.cloudflare @1.1.1.1 $DIG_OPTS 2>/dev/null | $SED -n 's/^"\(.*\)"$/\1/p' | $AWK '/^([0-9]{1,3}\.){3}[0-9]{1,3}$/{print; exit}')
    fi
fi

# Public IPv6 lookup runs only when a global IPv6 scope address exists.
if [ "$HAS_V6" -eq 1 ]; then
    PUBIP_V6=$($DIG -6 @ns1.google.com TXT o-o.myaddr.l.google.com $DIG_OPTS 2>/dev/null | $SED -n 's/^"\(.*\)"$/\1/p' | $AWK '/^[0-9A-Fa-f:]+$/{print; exit}')
    if [ -z "$PUBIP_V6" ] || [ "$PUBIP_V6" = "::" ]; then
        PUBIP_V6=$($DIG -6 TXT ch whoami.cloudflare @2606:4700:4700::1111 $DIG_OPTS 2>/dev/null | $SED -n 's/^"\(.*\)"$/\1/p' | $AWK '/^[0-9A-Fa-f:]+$/{print; exit}')
    fi
fi

PUBIP_DISPLAY_V4=$([ "$HAS_V4" -eq 1 ] && printf '%s' "${PUBIP_V4:-n/a}" || printf 'n/a')
PUBIP_DISPLAY_V6=$([ "$HAS_V6" -eq 1 ] && printf '%s' "${PUBIP_V6:-n/a}" || printf 'n/a')
PUBIP_SUMMARY="IPv4 ${PUBIP_DISPLAY_V4}, IPv6 ${PUBIP_DISPLAY_V6}"

# Failover policy treats wired-down interfaces as expected when Wi-Fi is up and no wired interface is currently usable.
if [ "$WIFI_UP_COUNT" -gt 0 ] && [ "$WIRED_UP_COUNT" -eq 0 ] && [ "$WIRED_DOWN_COUNT" -gt 0 ]; then
    FAILOVER_NOTE="Failover active via Wi-Fi (${WIFI_UP_LIST}); ignoring wired down: ${WIRED_DOWN_LIST}"
else
    # In all other cases, wired-down interfaces are direct network failures.
    if [ "$WIRED_DOWN_COUNT" -gt 0 ]; then
        add_crit "wired interfaces down: ${WIRED_DOWN_LIST}"
    fi
fi

# No usable interface is a direct network failure regardless of failover policy.
[ "$UP_COUNT" -eq 0 ] && add_crit "no interfaces up"

# Explain which parts of the network inventory can change the monitoring state.
limit_long_output_details
append_long ""
append_long "Interpretation:"
append_long "Service state, filter matches, no usable interface, and wired-down failover policy decide the exit code; interface address lists, Wi-Fi AP identity, kernel counters, and public-IP lookup results are supporting context."
append_long "Inspect named down services or wired interfaces first. Public-IP values of n/a are contextual unless the summary also reports a direct interface or service failure."

# Compose a cause-oriented short output; counters stay in perfdata and interface inventory stays in long output.
MSG="Network is healthy; public IPs: $PUBIP_SUMMARY"
[ -n "$FAILOVER_NOTE" ] && MSG="$MSG; $FAILOVER_NOTE"

# Finalize message/state with the direct failure cause first.
if [ -n "$CRIT_MSG" ]; then
    MSG="Network $CRIT_MSG; public IPs: $PUBIP_SUMMARY"
    [ -n "$FAILOVER_NOTE" ] && MSG="$MSG; $FAILOVER_NOTE"
    STATE_CODE=2
fi

# Global perfdata
INTERFACES_TOTAL=$((UP_COUNT + DOWN_COUNT))
PERF_GLOBAL="interfaces_total=${INTERFACES_TOTAL};;;0"
PERF_GLOBAL="$PERF_GLOBAL interfaces_up=${UP_COUNT};;;0"
PERF_GLOBAL="$PERF_GLOBAL interfaces_down=${DOWN_COUNT};;;0"
PERF_GLOBAL="$PERF_GLOBAL ipv4_total=${IPV4_TOTAL};;;0"
PERF_GLOBAL="$PERF_GLOBAL ipv4_public=${IPV4_PUBLIC};;;0"
PERF_GLOBAL="$PERF_GLOBAL ipv4_private=${IPV4_PRIVATE};;;0"
PERF_GLOBAL="$PERF_GLOBAL ipv4_cgnat=${IPV4_CGNAT};;;0"
PERF_GLOBAL="$PERF_GLOBAL ipv4_link_local=${IPV4_LINK};;;0"
PERF_GLOBAL="$PERF_GLOBAL ipv4_loopback=${IPV4_LOOP};;;0"
PERF_GLOBAL="$PERF_GLOBAL ipv6_total=${IPV6_TOTAL};;;0"
PERF_GLOBAL="$PERF_GLOBAL ipv6_scope_global=${IPV6_SCOPE_GLOBAL};;;0"
PERF_GLOBAL="$PERF_GLOBAL ipv6_gua=${IPV6_GUA};;;0"
PERF_GLOBAL="$PERF_GLOBAL ipv6_ula=${IPV6_ULA};;;0"
PERF_GLOBAL="$PERF_GLOBAL ipv6_link_local=${IPV6_LINK};;;0"
