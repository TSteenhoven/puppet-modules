#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'systemd service check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
CUT=$(command -v cut 2>/dev/null) || die "cut not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
GREP=$(command -v grep 2>/dev/null) || die "grep not available"
JOURNALCTL=$(command -v journalctl 2>/dev/null) || die "journalctl not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
SYSTEMCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
TAIL=$(command -v tail 2>/dev/null) || die "tail not available"
TR=$(command -v tr 2>/dev/null) || die "tr not available"

# Journal limits and runtime policy can be set independently for each invocation.
LOG_LINES=${LOG_LINES:-20}              # max journal lines to print below the summary
WINDOW=${WINDOW:-600}                   # seconds of journal to scan (default 10m)
MAXLOG=${MAXLOG:-1000}                  # max characters per journal line in long output
DETAIL_LIMIT=${DETAIL_LIMIT:-6000} # max characters before Interpretation
REQUIRE_ACTIVE=${REQUIRE_ACTIVE:-1}     # 1=service must be active, 0=oneshot-style allowed
SCAN_LOGS=${SCAN_LOGS:-1}               # 1=scan journal, 0=skip

# Schedule controls suppress expected downtime windows unless explicit outside-schedule alerting is requested.
ACTIVE_WINDOWS=${ACTIVE_WINDOWS:-""}            # e.g. "08:00-18:00" or "08:00-12:00,13:00-17:00"
ACTIVE_DAYS=${ACTIVE_DAYS:-""}                  # e.g. "Mon-Fri" or "1-5" or "Mon,Wed,Fri"
SCAN_LOGS_OUTSIDE=${SCAN_LOGS_OUTSIDE:-1}       # 1=still scan logs outside schedule
ACTIVE_ALERT_OUTSIDE=${ACTIVE_ALERT_OUTSIDE:-0} # 1=CRITICAL if service is active outside schedule
IN_SCHEDULE=1
SUPPRESS_REASON=""
SCHEDULE_DEFINED=0
OUTSIDE_SUPPRESS=0

# Log patterns are extended regexes; failure scanning is enabled by default while warnings remain opt-in.
FAIL_RE=${FAIL_RE:-'Failed with result|status=[1-9][0-9]*|segfault|core dumped|fatal|panic'}
WARN_RE=${WARN_RE:-''} # keep empty by default (avoid noisy WARNINGs)

# CLI options select schedule controls, journal limits and runtime policy for one invocation.
USAGE_TEXT="Usage: $0 [-W <HH:MM-HH:MM[,HH:MM-HH:MM...]>] [-D <dayspec>] [-a] [-l chars] [-n lines] [-t seconds] [-m chars_per_line] [-r 0|1] [-s 0|1] [-o 0|1] [-F failure_regex] [-w warning_regex] [-A] <service>
Environment: ACTIVE_WINDOWS (-W); ACTIVE_DAYS (-D); ACTIVE_ALERT_OUTSIDE (-a); DETAIL_LIMIT (-l); LOG_LINES (-n); WINDOW (-t); MAXLOG (-m); REQUIRE_ACTIVE (-r); SCAN_LOGS (-s); SCAN_LOGS_OUTSIDE (-o); FAIL_RE (-F); WARN_RE (-w); ACTIVE_ALERT_OUTSIDE (-A).
Command-line options override non-empty environment values; unset or empty environment values use defaults.
-a/-A enable/disable alerts for active services outside the schedule."
OPTERR=0
while getopts ":W:D:al:n:t:m:r:s:o:F:w:Ah" OPT; do
    case "$OPT" in
        W) ACTIVE_WINDOWS="$OPTARG" ;;
        D) ACTIVE_DAYS="$OPTARG" ;;
        a) ACTIVE_ALERT_OUTSIDE=1 ;;
        l) DETAIL_LIMIT=$OPTARG ;;
        n) LOG_LINES=$OPTARG ;;
        t) WINDOW=$OPTARG ;;
        m) MAXLOG=$OPTARG ;;
        r) REQUIRE_ACTIVE=$OPTARG ;;
        s) SCAN_LOGS=$OPTARG ;;
        o) SCAN_LOGS_OUTSIDE=$OPTARG ;;
        F) FAIL_RE=$OPTARG ;;
        w) WARN_RE=$OPTARG ;;
        A) ACTIVE_ALERT_OUTSIDE=0 ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))

# Accept both bare service names and fully-qualified .service units.
[ "$#" -eq 1 ] || die "$USAGE_TEXT"
UNIT=$1
case "$UNIT" in
    *.service) SERVICE_UNIT="$UNIT" ;;
    *)         SERVICE_UNIT="${UNIT}.service" ;;
esac

# Validate diagnostic output limits before journal text is rendered.
case "$LOG_LINES" in
    ''|*[!0-9]*) die "LOG_LINES must be numeric" ;;
esac
case "$MAXLOG" in
    ''|*[!0-9]*) die "MAXLOG must be numeric" ;;
esac
case "$WINDOW" in
    ''|*[!0-9]*) die "WINDOW must be numeric" ;;
esac
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "DETAIL_LIMIT must be numeric" ;;
esac
[ "$LOG_LINES" -ge 1 ] || die "LOG_LINES must be at least 1"
[ "$MAXLOG" -ge 1 ] || die "MAXLOG must be at least 1"
[ "$WINDOW" -ge 1 ] || die "WINDOW must be at least 1"
[ "$DETAIL_LIMIT" -ge 1 ] || die "DETAIL_LIMIT must be at least 1"
case "$REQUIRE_ACTIVE" in
    0|1) : ;;
    *) die "REQUIRE_ACTIVE must be 0 or 1" ;;
esac
case "$SCAN_LOGS" in
    0|1) : ;;
    *) die "SCAN_LOGS must be 0 or 1" ;;
esac
case "$SCAN_LOGS_OUTSIDE" in
    0|1) : ;;
    *) die "SCAN_LOGS_OUTSIDE must be 0 or 1" ;;
esac
case "$ACTIVE_ALERT_OUTSIDE" in
    0|1) : ;;
    *) die "ACTIVE_ALERT_OUTSIDE must be 0 or 1" ;;
esac

# Validate operator-provided journal regexes before grep is used for state decisions.
validate_regex() {
    [ -n "$2" ] || return 0
    $GREP -E "$2" /dev/null >/dev/null 2>&1
    [ "$?" -eq 2 ] && die "invalid $1 regex"
}
validate_regex 'FAIL_RE' "$FAIL_RE"
validate_regex 'WARN_RE' "$WARN_RE"

# Track whether any schedule input exists so outside-window behavior is explicit.
if [ -n "$ACTIVE_WINDOWS" ] || [ -n "$ACTIVE_DAYS" ]; then
    SCHEDULE_DEFINED=1
fi

# Normalize decimal time fields before POSIX shell arithmetic so 08 and 09 are not interpreted as octal.
strip_leading_zeroes() {
    VALUE=$1
    while [ "${VALUE#0}" != "$VALUE" ]; do
        VALUE=${VALUE#0}
    done
    [ -n "$VALUE" ] || VALUE=0
    printf '%s\n' "$VALUE"
}

# Convert HH:MM to minutes since midnight.
hm2min() {
    H=${1%:*}
    M=${1#*:}
    H=$(strip_leading_zeroes "$H")
    M=$(strip_leading_zeroes "$M")
    case "$H" in (*[!0-9]*) H=0 ;; esac
    case "$M" in (*[!0-9]*) M=0 ;; esac
    printf '%s\n' "$(( H*60 + M ))"
}

# Check whether the current time falls within one window.
in_window() {
    WIN="$1"
    START=${WIN%-*}
    END=${WIN#*-}
    S=$(hm2min "$START")
    E=$(hm2min "$END")

    if [ "$S" -le "$E" ]; then
        if [ "$NOW_MIN" -ge "$S" ] && [ "$NOW_MIN" -le "$E" ]; then
            printf '%s\n' 1
        else
            printf '%s\n' 0
        fi
    else
        # window spans midnight
        if [ "$NOW_MIN" -ge "$S" ] || [ "$NOW_MIN" -le "$E" ]; then
            printf '%s\n' 1
        else
            printf '%s\n' 0
        fi
    fi
}

# Convert a day name or number to systemd weekday numbering.
day_to_num() {
    d=$(printf '%s' "$1" | $TR 'A-Z' 'a-z')
    case "$d" in
        1|mon|monday) printf '%s\n' 1 ;;
        2|tue|tues|tuesday) printf '%s\n' 2 ;;
        3|wed|weds|wednesday) printf '%s\n' 3 ;;
        4|thu|thur|thurs|thursday) printf '%s\n' 4 ;;
        5|fri|friday) printf '%s\n' 5 ;;
        6|sat|saturday) printf '%s\n' 6 ;;
        0|7|sun|sunday) printf '%s\n' 7 ;;
        *) printf '\n' ;;
    esac
}

# Check whether the current weekday matches one dayspec token list.
day_in_spec() {
    SPEC="$1"
    [ -z "$SPEC" ] && { printf '%s\n' 1; return; }
    SPEC_N=$(printf '%s' "$SPEC" | $TR ',' ' ')

    for PART in $SPEC_N; do
        PART_L=$(printf '%s' "$PART" | $TR 'A-Z' 'a-z')
        case "$PART_L" in
            *-*)
                S=${PART_L%-*}
                E=${PART_L#*-}
                SN=$(day_to_num "$S")
                EN=$(day_to_num "$E")
                [ -n "$SN" ] && [ -n "$EN" ] || continue

                if [ "$SN" -le "$EN" ]; then
                    if [ "$DOW" -ge "$SN" ] && [ "$DOW" -le "$EN" ]; then
                        printf '%s\n' 1
                        return
                    fi
                else
                    # range wraps across week boundary
                    if [ "$DOW" -ge "$SN" ] || [ "$DOW" -le "$EN" ]; then
                        printf '%s\n' 1
                        return
                    fi
                fi
                ;;
            *)
                PN=$(day_to_num "$PART_L")
                [ -n "$PN" ] && [ "$DOW" -eq "$PN" ] && { printf '%s\n' 1; return; }
                ;;
        esac
    done
    printf '%s\n' 0
}

# Reject malformed schedules before a typo can suppress a service failure.
if [ -n "$ACTIVE_WINDOWS" ]; then
    printf '%s\n' "$ACTIVE_WINDOWS" | $AWK '
        {
            count = split($0, windows, /[,[:space:]]+/)
            for (i = 1; i <= count; i++) {
                if (windows[i] !~ /^[0-9][0-9]:[0-9][0-9]-[0-9][0-9]:[0-9][0-9]$/) exit 1
                split(windows[i], fields, /[:-]/)
                if (fields[1] > 23 || fields[2] > 59 || fields[3] > 23 || fields[4] > 59) exit 1
            }
        }
    ' || die "invalid ACTIVE_WINDOWS schedule"
fi
if [ -n "$ACTIVE_DAYS" ]; then
    DAY_PARTS=$(printf '%s' "$ACTIVE_DAYS" | $TR ',' ' ')
    [ -n "$DAY_PARTS" ] || die "invalid ACTIVE_DAYS schedule"
    for DAY_PART in $DAY_PARTS; do
        case "$DAY_PART" in
            *-*)
                [ -n "$(day_to_num "${DAY_PART%-*}")" ] && [ -n "$(day_to_num "${DAY_PART#*-}")" ] || die "invalid ACTIVE_DAYS range"
                ;;
            *) [ -n "$(day_to_num "$DAY_PART")" ] || die "invalid ACTIVE_DAYS day" ;;
        esac
    done
fi

# Capture current time once so day/window checks agree throughout the run.
NOW_TS=$($DATE +%s)
NOW_HM=$($DATE +%H:%M)
DOW=$($DATE +%u 2>/dev/null || printf '0')  # 1=Mon .. 7=Sun
NOW_MIN=$(hm2min "$NOW_HM")

# Day filters are evaluated before time windows to preserve the direct suppression reason.
if [ -n "$ACTIVE_DAYS" ] && [ "$(day_in_spec "$ACTIVE_DAYS")" != "1" ]; then
    IN_SCHEDULE=0
    SUPPRESS_REASON="day-outside"
fi

# Window filters support comma-separated ranges, including ranges that cross midnight.
if [ "$IN_SCHEDULE" = "1" ] && [ -n "$ACTIVE_WINDOWS" ]; then
    WINS=$(printf '%s' "$ACTIVE_WINDOWS" | $TR ',' ' ')
    ACTIVE_NOW=0

    for WIN in $WINS; do
        case "$WIN" in
            ??:??-??:??) : ;;
            *) continue ;;
        esac
        [ "$(in_window "$WIN")" = "1" ] && { ACTIVE_NOW=1; break; }
    done

    [ "$ACTIVE_NOW" -eq 1 ] || { IN_SCHEDULE=0; SUPPRESS_REASON="outside-window"; }
fi

# Outside-schedule suppression returns OK unless the caller explicitly requests active-service alerts.
if [ "$SCHEDULE_DEFINED" = "1" ] && [ "$IN_SCHEDULE" != "1" ] && [ "$ACTIVE_ALERT_OUTSIDE" != "1" ]; then
    OUTSIDE_SUPPRESS=1
fi

# Helper: extract property from a cached `systemctl show` blob
get_prop() {
    # $1 = key
    printf '%s\n' "$SHOW" | $GREP "^$1=" | $CUT -d= -f2-
}

# Helper: parse a systemd timestamp (text) to epoch, or empty
parse_ts() {
    # $1 = text (e.g. "Fri 2026-01-16 08:55:12 CET" or "n/a")
    [ -n "${1:-}" ] || return 1
    [ "$1" = "n/a" ] && return 1
    $DATE -d "$1" +%s 2>/dev/null
}

# Preserve Nagios U values while appending UOM to numeric age metrics.
metric_value_with_unit() {
    case "$1" in
        ''|U|*[!0-9]*) printf '%s' 'U' ;;
        *)             printf '%s%s' "$1" "$2" ;;
    esac
}

# Helper: emit a check line with optional journal info
emit_check() {
    # $1 = summary/status line, $2 = perfdata
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "${JOURNAL_JOINED:-}" ]; then
        monitor_text_value "$JOURNAL_JOINED"
    fi
}

# Nagios treats raw pipes after the first output line as perfdata separators.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Format journal lines with a configurable line count and per-line character cap.
format_journal_lines() {
    printf '%s\n' "$1" | $SED '/^$/d; s/[[:space:]]\+$//' | $AWK -v max="$MAXLOG" '
        {
            line = $0
            if (length(line) > max) {
                line = substr(line, 1, max) "... [line truncated]"
            }
            print "- " line
        }
    '
}

# Bound journal details before adding Interpretation so final operator guidance stays visible in monitoring UIs.
limit_text_details() {
    $AWK -v max="$DETAIL_LIMIT" '
        {
            line = $0
            line_len = length(line)
            separator_len = printed ? 1 : 0
            if (used + separator_len + line_len <= max) {
                print line
                used += separator_len + line_len
                printed = 1
                next
            }
            remaining = max - used - separator_len
            if (remaining > 0) {
                print substr(line, 1, remaining) "... [detail truncated]"
            }
            print "Long output details truncated after " max " characters to keep Interpretation visible."
            exit
        }
    '
}

# Pull all required systemd properties in one call to reduce check latency.
SHOW=$($SYSTEMCTL show "$SERVICE_UNIT" \
    -p LoadState -p ActiveState -p SubState -p Result \
    -p MainPID -p NRestarts \
    -p ExecMainStatus -p ExecMainCode -p StatusText \
    -p ActiveEnterTimestamp -p InactiveEnterTimestamp -p StateChangeTimestamp \
    2>/dev/null)
LOAD_STATE=$(get_prop LoadState)

# Check existence and load state
if [ -z "$LOAD_STATE" ] || [ "$LOAD_STATE" = "not-found" ]; then
    emit_check "${SERVICE_UNIT} does not exist" "active_age=U last_change_age=U restarts=U exit_code=U in_schedule=${IN_SCHEDULE}"
    exit 2
fi

# Outside-schedule missing units are accepted only when suppression is active.
if [ "$OUTSIDE_SUPPRESS" = "1" ] && [ "$LOAD_STATE" != "loaded" ]; then
    emit_check "${SERVICE_UNIT} outside schedule (${SUPPRESS_REASON:-outside}); unit is not loaded (load state ${LOAD_STATE})" "active_age=U last_change_age=U restarts=U exit_code=U in_schedule=${IN_SCHEDULE}"
    exit 0
elif [ "$LOAD_STATE" != "loaded" ]; then
    emit_check "${SERVICE_UNIT} is not loaded (load state ${LOAD_STATE})" "active_age=U last_change_age=U restarts=U exit_code=U in_schedule=${IN_SCHEDULE}"
    exit 2
fi

# Cache individual properties for status decisions and summary text.
ACTIVE_STATE=$(get_prop ActiveState)
SUB_STATE=$(get_prop SubState)
RESULT_PROP=$(get_prop Result)
MAIN_PID=$(get_prop MainPID)
NRESTARTS=$(get_prop NRestarts)
EXEC_STATUS=$(get_prop ExecMainStatus)
EXEC_CODE=$(get_prop ExecMainCode)
STATUS_TEXT=$(get_prop StatusText)
ACTIVE_ENTER=$(get_prop ActiveEnterTimestamp)
STATE_CHANGE=$(get_prop StateChangeTimestamp)

# Convert systemd timestamps into age perfdata where possible.
NOW_TS=$($DATE +%s)
ACTIVE_ENTER_TS=""
STATE_CHANGE_TS=""
LAST_CHANGE_TEXT="${STATE_CHANGE:-}"

# Parse timestamps
if ts=$(parse_ts "$ACTIVE_ENTER" 2>/dev/null); then ACTIVE_ENTER_TS="$ts"; fi
if ts=$(parse_ts "$STATE_CHANGE" 2>/dev/null); then STATE_CHANGE_TS="$ts"; fi

# Calculate ages
ACTIVE_AGE=U
LAST_CHANGE_AGE=U
if [ -n "$ACTIVE_ENTER_TS" ] && [ "$ACTIVE_ENTER_TS" -le "$NOW_TS" ]; then
    ACTIVE_AGE=$((NOW_TS - ACTIVE_ENTER_TS))
fi
if [ -n "$STATE_CHANGE_TS" ] && [ "$STATE_CHANGE_TS" -le "$NOW_TS" ]; then
    LAST_CHANGE_AGE=$((NOW_TS - STATE_CHANGE_TS))
fi

# Journal scanning is anchored to the most recent relevant service state change.
JOURNAL_RAW=""
FAIL_LINE=""
WARN_LINE=""
SINCE_TS=$((NOW_TS - WINDOW))
REF_TS=$SINCE_TS

# Prefer active-enter time for running services and state-change time for non-running services.
if [ "$ACTIVE_STATE" = "active" ] && [ -n "$ACTIVE_ENTER_TS" ] && [ "$ACTIVE_ENTER_TS" -gt "$SINCE_TS" ]; then
    REF_TS=$ACTIVE_ENTER_TS
elif [ "$ACTIVE_STATE" != "active" ] && [ -n "$STATE_CHANGE_TS" ] && [ "$STATE_CHANGE_TS" -gt "$SINCE_TS" ]; then
    REF_TS=$STATE_CHANGE_TS
fi

# Pull only recent journal entries when runtime policy allows log scanning.
if [ "$SCAN_LOGS" = "1" ] && { [ "$IN_SCHEDULE" = "1" ] || [ "$SCAN_LOGS_OUTSIDE" = "1" ]; }; then
    JOURNAL_RAW=$($JOURNALCTL -u "$SERVICE_UNIT" --since "@${REF_TS}" -o short-iso --no-pager 2>/dev/null || true)
    if [ -n "$JOURNAL_RAW" ]; then
        FAIL_LINE=$(printf '%s\n' "$JOURNAL_RAW" | $GREP -Ei "$FAIL_RE" | $TAIL -n1)
        if [ -n "$WARN_RE" ]; then
            WARN_LINE=$(printf '%s\n' "$JOURNAL_RAW" | $GREP -Ei "$WARN_RE" | $TAIL -n1)
        fi
    fi
fi

# Render journal for long output with a predictable line cap.
JOURNAL_LINE_COUNT=$(printf '%s\n' "$JOURNAL_RAW" | $SED '/^$/d' | $SED -n '$=')
case "$JOURNAL_LINE_COUNT" in
    ''|*[!0-9]*) JOURNAL_LINE_COUNT=0 ;;
esac

if [ "$JOURNAL_LINE_COUNT" -gt 0 ]; then
    if [ "$JOURNAL_LINE_COUNT" -gt "$LOG_LINES" ]; then
        JOURNAL_OMITTED=$((JOURNAL_LINE_COUNT - LOG_LINES))
        JOURNAL_JOINED=$(
            {
                printf '%s\n' "- Showing last ${LOG_LINES} journal lines for ${SERVICE_UNIT}; ${JOURNAL_OMITTED} older line(s) omitted"
                format_journal_lines "$JOURNAL_RAW" | $TAIL -n "$LOG_LINES"
            }
        )
    else
        JOURNAL_JOINED=$(format_journal_lines "$JOURNAL_RAW")
    fi
else
    JOURNAL_JOINED=""
fi

# Add interpretation after journal details when long output exists.
if [ -n "$JOURNAL_JOINED" ]; then
    JOURNAL_JOINED=$(
        {
            printf '%s\n' "$JOURNAL_JOINED" | limit_text_details
            printf '%s\n' ''
            printf '%s\n' 'Interpretation:'
            printf '%s\n' 'systemctl unit properties, schedule policy, require-active policy, and configured journal failure/warning regex matches decide the exit code.'
            printf '%s\n' 'Other journal lines are bounded diagnostic context. Inspect the named unit status and recent journal first when the summary reports inactive, failed, transitional, outside-schedule, or marker-based service state.'
        }
    )
fi

# Perfdata mirrors the service state age, restart count, exit status, and schedule state.
ACTIVE_AGE_METRIC=$(metric_value_with_unit "$ACTIVE_AGE" s)
LAST_CHANGE_AGE_METRIC=$(metric_value_with_unit "$LAST_CHANGE_AGE" s)
RESTARTS_METRIC=$(metric_value_with_unit "${NRESTARTS:-U}" c)
PERFDATA="active_age=${ACTIVE_AGE_METRIC} last_change_age=${LAST_CHANGE_AGE_METRIC} restarts=${RESTARTS_METRIC} exit_code=${EXEC_STATUS:-U} in_schedule=${IN_SCHEDULE}"

# Outside schedule (no -a): always OK, but include full status/perfdata
if [ "$SCHEDULE_DEFINED" = "1" ] && [ "$IN_SCHEDULE" != "1" ] && [ "$ACTIVE_ALERT_OUTSIDE" != "1" ]; then
    emit_check \
        "$SERVICE_UNIT outside schedule (${SUPPRESS_REASON:-outside}); state ${ACTIVE_STATE:-unknown}/${SUB_STATE:-unknown} with result ${RESULT_PROP:-unknown}; last change: ${LAST_CHANGE_TEXT:-unknown}; status: ${STATUS_TEXT:-unknown}" \
        "$PERFDATA"
    exit 0
fi

# Outside schedule alerting is healthy when the unit is inactive and CRITICAL when it is still active.
if [ "$SCHEDULE_DEFINED" = "1" ] && [ "$IN_SCHEDULE" != "1" ] && [ "$ACTIVE_ALERT_OUTSIDE" = "1" ] && [ "$ACTIVE_STATE" != "active" ]; then
    emit_check \
        "$SERVICE_UNIT outside schedule (${SUPPRESS_REASON:-outside}); state ${ACTIVE_STATE:-unknown}/${SUB_STATE:-unknown} with result ${RESULT_PROP:-unknown}; last change: ${LAST_CHANGE_TEXT:-unknown}; status: ${STATUS_TEXT:-unknown}" \
        "$PERFDATA"
    exit 0
fi

if [ "$SCHEDULE_DEFINED" = "1" ] && [ "$IN_SCHEDULE" != "1" ] && [ "$ACTIVE_ALERT_OUTSIDE" = "1" ] && [ "$ACTIVE_STATE" = "active" ]; then
    emit_check \
        "$SERVICE_UNIT active outside schedule (${SUPPRESS_REASON:-outside}); state ${ACTIVE_STATE}/${SUB_STATE} with result ${RESULT_PROP:-unknown}; active since ${ACTIVE_ENTER:-unknown}; main PID ${MAIN_PID:-0}; status: ${STATUS_TEXT:-unknown}" \
        "$PERFDATA"
    exit 2
fi

# Failed state is always CRITICAL regardless of journal scanning.
if [ "$ACTIVE_STATE" = "failed" ]; then
    emit_check \
        "$SERVICE_UNIT failed with state ${ACTIVE_STATE}/${SUB_STATE}, result ${RESULT_PROP}, exit status ${EXEC_STATUS:-U}, and code ${EXEC_CODE:-U}; last change: ${LAST_CHANGE_TEXT:-unknown}; status: ${STATUS_TEXT:-unknown}" \
        "$PERFDATA"
    exit 2
fi

# By default services must be active; oneshot-style services opt out via REQUIRE_ACTIVE=0.
if [ "$REQUIRE_ACTIVE" = "1" ] && [ "$ACTIVE_STATE" != "active" ]; then
    case "$ACTIVE_STATE" in
        activating|deactivating)
            emit_check \
                "$SERVICE_UNIT is transitional with state ${ACTIVE_STATE}/${SUB_STATE}; last change: ${LAST_CHANGE_TEXT:-unknown}; status: ${STATUS_TEXT:-unknown}" \
                "$PERFDATA"
            exit 1
            ;;
        inactive)
            emit_check \
                "$SERVICE_UNIT is inactive with result ${RESULT_PROP}, exit status ${EXEC_STATUS:-U}, and code ${EXEC_CODE:-U}; last change: ${LAST_CHANGE_TEXT:-unknown}; status: ${STATUS_TEXT:-unknown}" \
                "$PERFDATA"
            exit 2
            ;;
        *)
            emit_check \
                "$SERVICE_UNIT has unknown state ${ACTIVE_STATE:-unknown}/${SUB_STATE:-unknown}; last change: ${LAST_CHANGE_TEXT:-unknown}; status: ${STATUS_TEXT:-unknown}" \
                "$PERFDATA"
            exit 3
            ;;
    esac
fi

# A recent journal failure marker upgrades an otherwise active service to CRITICAL.
if [ -n "$FAIL_LINE" ]; then
    emit_check \
        "$SERVICE_UNIT is active but the journal contains a recent failure marker; active since ${ACTIVE_ENTER:-unknown}; main PID ${MAIN_PID:-0}; restart count ${NRESTARTS:-U}; status: ${STATUS_TEXT:-unknown}" \
        "$PERFDATA"
    exit 2
fi

# Warning markers are opt-in through WARN_RE and only affect otherwise healthy services.
if [ -n "$WARN_LINE" ]; then
    emit_check \
        "$SERVICE_UNIT journal contains a recent warning marker; active since ${ACTIVE_ENTER:-unknown}; main PID ${MAIN_PID:-0}; restart count ${NRESTARTS:-U}; status: ${STATUS_TEXT:-unknown}" \
        "$PERFDATA"
    exit 1
fi

# For oneshot-style services, a clean last result is healthy even when the unit is inactive.
if [ "$REQUIRE_ACTIVE" = "0" ] && [ "$ACTIVE_STATE" != "active" ]; then
    if [ "${EXEC_STATUS:-U}" = "0" ] && { [ "$RESULT_PROP" = "success" ] || [ "$RESULT_PROP" = "" ] || [ "$RESULT_PROP" = "n/a" ]; }; then
        emit_check \
            "$SERVICE_UNIT is not active as expected for oneshot-style service and the last result was successful; last change: ${LAST_CHANGE_TEXT:-unknown}; status: ${STATUS_TEXT:-unknown}" \
            "$PERFDATA"
        exit 0
    fi
fi

# Normal success path for active services with no relevant journal markers.
emit_check \
    "$SERVICE_UNIT is running as expected with state ${ACTIVE_STATE:-unknown}/${SUB_STATE:-unknown} and result ${RESULT_PROP:-unknown}; active since ${ACTIVE_ENTER:-unknown}; main PID ${MAIN_PID:-0}; restart count ${NRESTARTS:-U}; status: ${STATUS_TEXT:-unknown}" \
    "$PERFDATA"
exit 0
